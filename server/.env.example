NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Generate at least 32 random bytes locally (base64url). Never commit the real value.
AUTH_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_43_CHARACTERS
AUTH_ISSUER=wheel-accesses
AUTH_AUDIENCE=wheel-accesses-client
AUTH_ACCESS_SECONDS=600
AUTH_REFRESH_DAYS=14
# Refresh cookie is host-only, HttpOnly, SameSite=Strict, path=/api/v1/auth.
# Secure is mandatory when NODE_ENV=production; deploy frontend/API on the same site.

# Recommended for a local Windows-only SQL Server instance.
DATABASE_URL="sqlserver://127.0.0.1:1433;database=wheel_accesses_dev;integratedSecurity=true;encrypt=true;trustServerCertificate=true;schema=dbo"

# SQL authentication alternative (only when intentionally enabled and locally configured):
# DATABASE_URL="sqlserver://127.0.0.1:1433;database=wheel_accesses_dev;user=YOUR_USERNAME;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true;schema=dbo"
