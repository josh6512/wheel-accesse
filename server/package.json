{
  "name": "@wheel-accesses/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "tsc -p tsconfig.test.json --noEmit --pretty false && tsx --test test/*.test.ts",
    "test:auth:database": "tsx --test test/database/auth.database.ts",
    "test:community:database": "tsx --test test/database/community.database.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p tsconfig.prisma.json --noEmit --pretty false",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "8.3.0",
    "jose": "^6.2.12",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "prisma": "6.19.3",
    "tsx": "4.23.13"
  }
}
